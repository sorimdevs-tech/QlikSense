# Qlik Sense Cloud API Credentials
# Get these from your Qlik Cloud tenant: https://your-tenant.qlikcloud.com/console/api-keys
QLIK_CLIENT_ID=your_client_id_here
QLIK_CLIENT_SECRET=your_client_secret_here

# Optional: API Configuration (usually auto-detected)
# QLIK_TENANT_URL=https://your-tenant.qlikcloud.com
# QLIK_API_BASE_URL=https://your-tenant.qlikcloud.com/api/v1
